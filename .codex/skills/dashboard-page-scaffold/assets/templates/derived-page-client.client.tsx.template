"use client";

import { useState } from "react";
import type { TimeRange } from "@/lib/spotify/types";
import { SpotifyAttribution } from "@/components/spotify-stats-logo";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";

interface {{ItemTypeName}} {
  id: string;
  name: string;
}

interface {{ClientComponentName}}Props {
  {{dataPropName}}: {
    short_term: {{ItemTypeName}}[];
    medium_term: {{ItemTypeName}}[];
    long_term: {{ItemTypeName}}[];
  };
}

export function {{ClientComponentName}}({ {{dataPropName}} }: {{ClientComponentName}}Props) {
  const [timeRange, setTimeRange] = useState<TimeRange>("medium_term");
  const items = {{dataPropName}}[timeRange];

  return (
    <div className="space-y-6">
      <div className="flex items-start justify-between">
        <div>
          <h1 className="text-2xl font-bold tracking-tight">{{pageTitle}}</h1>
          <p className="text-muted-foreground">{{pageDescription}}</p>
        </div>
        <SpotifyAttribution className="hidden md:flex" />
      </div>

      <Tabs value={timeRange} onValueChange={(value) => setTimeRange(value as TimeRange)} className="w-full">
        <TabsList>
          <TabsTrigger value="short_term">Last 4 Weeks</TabsTrigger>
          <TabsTrigger value="medium_term">Last 6 Months</TabsTrigger>
          <TabsTrigger value="long_term">All Time</TabsTrigger>
        </TabsList>

        <TabsContent value={timeRange} className="mt-6">
          <div className="space-y-2">
            {items.map((item) => (
              <div key={item.id} className="rounded-md border p-4">
                <p className="font-medium">{item.name}</p>
              </div>
            ))}
          </div>
        </TabsContent>
      </Tabs>
    </div>
  );
}

